{
  "moveGuide": {
    "plank hold": {
      "desc": "Tahan posisi tubuh lurus seperti papan untuk melatih core, bahu, dan glute. Fondasi kontrol tubuh sebelum push-up.",
      "cues": [
        "Badan satu garis kepala-tumit",
        "Scapula protracted (dorong lantai)",
        "Jangan biarkan pinggang melorot atau naik (pike)"
      ]
    },
    "scapula push-ups": {
      "desc": "Lengan tetap lurus; gerakan hanya dari shoulder blade. Melatih stabilitas bahu untuk push-up yang aman.",
      "cues": [
        "Lengan terkunci lurus",
        "Retraksi lalu protraksi scapula",
        "Core tetap kencang"
      ]
    },
    "negative push-ups": {
      "desc": "Fokus fase turun (eksentrik) secara lambat untuk membangun kekuatan sebelum push-up penuh.",
      "cues": [
        "Turun 3-5 detik merata",
        "Dada mendekati lantai dengan kontrol",
        "Naik boleh dibantu lutut / dorong ke atas"
      ]
    },
    "normal push-ups": {
      "desc": "Push-up standar: tubuh lurus, tangan selebar bahu. Gerakan dasar kekuatan dorong tubuh.",
      "cues": [
        "Siku ~45° dari badan",
        "Core & glute aktif",
        "Dada hampir menyentuh lantai"
      ]
    },
    "wide push-ups": {
      "desc": "Tangan lebih lebar dari bahu untuk menekankan dada dan bahu depan.",
      "cues": [
        "Tangan lebih lebar dari bahu",
        "Jaga garis tubuh",
        "Jangan biarkan bahu collaps"
      ]
    },
    "diamond push-ups": {
      "desc": "Tangan rapat membentuk 'berlian'; beban lebih ke trisep dan dada dalam.",
      "cues": [
        "Ibu jari & telunjuk saling dekat",
        "Siku mendekat ke tubuh",
        "Core tetap kencang"
      ]
    },
    "tricep extensions": {
      "desc": "Variasi dorong yang menekankan ekstensi siku untuk memperkuat trisep sebagai pendukung OAPU.",
      "cues": [
        "Gerakan dari siku, bukan bahu",
        "ROM penuh yang nyaman",
        "Jaga tulang belakang netral"
      ]
    },
    "explosive push-ups": {
      "desc": "Push-up eksplosif untuk power. Dorong keras hingga tangan lepas / clap jika mampu.",
      "cues": [
        "Turun terkontrol, dorong cepat",
        "Mendarat dengan siku sedikit tekuk",
        "Mulai tanpa clap jika perlu"
      ]
    },
    "archer push-ups": {
      "desc": "Satu lengan bekerja lebih berat sementara lengan lain melurus; jembatan menuju one-arm push-up.",
      "cues": [
        "Beban di lengan yang menekuk",
        "Lengan 'bow' hampir lurus",
        "Ganti sisi merata"
      ]
    },
    "one-arm push-ups": {
      "desc": "Push-up satu lengan. Stance kaki lebar membantu balance; core harus sangat stabil.",
      "cues": [
        "Kaki lebar untuk stabilitas",
        "Bahu relatif sejajar (miring sedikit OK)",
        "Hindari rotasi berlebih"
      ]
    },
    "warm-up: band pull-aparts / pull-downs": {
      "desc": "Pemanasan bahu & punggung dengan band: pull-apart overhead/horizontal dan pull-down.",
      "cues": [
        "Bahu turun, jangan shrug",
        "Kontrol tarikan & kembali",
        "Band ringan, fokus aktivasi"
      ]
    },
    "bent-over rows": {
      "desc": "Tarikan horizontal (barbell/band) untuk membangun kekuatan punggung sebelum pull-up.",
      "cues": [
        "Punggung netral, hing hing",
        "Tarik ke tulang rusuk bawah",
        "Scapula retraksi di puncak"
      ]
    },
    "passive hang": {
      "desc": "Gantung santai dengan lengan lurus untuk grip, bahu, dan toleransi hang.",
      "cues": [
        "Pakai semua jari termasuk kelingking",
        "Bahu rileks (active/passive sesuai tujuan)",
        "Kaki rileks, napas tenang"
      ]
    },
    "scapula pull-ups": {
      "desc": "Dari dead hang, gerakkan hanya scapula (retraction + depression) tanpa menekuk siku.",
      "cues": [
        "Lengan tetap lurus",
        "Tarik bahu ke bawah-belakang",
        "Kontrol turun ke hang pasif"
      ]
    },
    "australian pull-ups": {
      "desc": "Inverted row di bar rendah. Semakin horizontal tubuh, semakin sulit.",
      "cues": [
        "Badan lurus seperti papan",
        "Tarik dada ke bar",
        "Atur sudut kaki untuk progresi"
      ]
    },
    "negative pull-ups": {
      "desc": "Mulai di atas bar, turun lambat ke hang. Membangun kekuatan eksentrik menuju pull-up.",
      "cues": [
        "Turun 5-10 detik",
        "Kontrol sepanjang ROM",
        "Naik bisa lompat / step-up"
      ]
    },
    "band-assisted pull-ups": {
      "desc": "Pull-up dengan bantuan resistance band. Kurangi ketebalan band seiring kuat.",
      "cues": [
        "Dead hang penuh di bawah",
        "Tarik dada ke bar",
        "Jangan kick berlebihan"
      ]
    },
    "pull-ups": {
      "desc": "Pull-up penuh dari dead hang hingga dagu melewati bar, dengan kontrol.",
      "cues": [
        "Mulai dead hang",
        "Core kencang (hindari swing besar)",
        "Turun penuh tiap rep"
      ]
    },
    "australian + scapula (superset)": {
      "desc": "Superset: Australian pull-up lalu scapula pull-up tanpa istirahat antar keduanya.",
      "cues": [
        "Australian dulu untuk volume",
        "Scapula untuk kontrol bahu",
        "Istirahat hanya setelah keduanya"
      ]
    },
    "bodyweight squats": {
      "desc": "Squat dua kaki standar untuk pola gerak, volume, dan daya tahan kaki.",
      "cues": [
        "Beban di tengah kaki (lebih ke tumit)",
        "Lutut sejajar jari kaki",
        "Dada tetap terbuka"
      ]
    },
    "narrow-stance squats": {
      "desc": "Squat dengan stance sempit untuk menuntut kontrol balance dan mobilitas lebih tinggi.",
      "cues": [
        "Kaki lebih rapat dari biasa",
        "Jaga tumit mentok lantai",
        "Turun terkontrol"
      ]
    },
    "deep squats": {
      "desc": "Squat dalam (di bawah parallel) untuk ROM dan kekuatan di posisi rendah. Jika kaku, utamakan mobility.",
      "cues": [
        "Turun sedalam yang aman",
        "Punggung tidak melengkung ekstrem",
        "Bisa pegang beban ringan untuk counterbalance"
      ]
    },
    "bulgarian split squats": {
      "desc": "Squat satu kaki dengan kaki belakang di elevasi. Melatih kekuatan unilateral.",
      "cues": [
        "Mayoritas beban di kaki depan (~90%)",
        "Lutut depan mengikuti jari kaki",
        "Badan sedikit condong ke depan OK"
      ]
    },
    "cossack squats": {
      "desc": "Squat lateral ke satu sisi dengan kaki lain lurus. Melatih ROM pinggul dan kekuatan samping.",
      "cues": [
        "Turun ke satu sisi penuh",
        "Kaki lain tetap lurus / tumit boleh angkat",
        "Ganti sisi merata"
      ]
    },
    "pistol easier variant (box / assisted / eccentric)": {
      "desc": "Variasi lebih mudah menuju pistol: box pistol, dibantu pegangan, atau turun eksentrik lambat.",
      "cues": [
        "Pilih variasi yang formnya bersih",
        "Lutut tidak collapse ke dalam",
        "Kaki bebas tidak menyentuh lantai"
      ]
    },
    "pistol easier variant": {
      "desc": "Variasi pistol yang dimudahkan (box / assisted / eccentric) untuk volume setelah attempt penuh.",
      "cues": [
        "Kualitas lebih penting dari kedalaman ekstrem",
        "Tekanan kaki merata (jari-tumit)",
        "Hindari knee valgus"
      ]
    },
    "pistol squats": {
      "desc": "Squat satu kaki penuh dengan kaki lain terangkat. Butuh kekuatan, balance, dan mobilitas.",
      "cues": [
        "Lengan ke depan untuk balance",
        "Turun & naik terkontrol",
        "Kaki bebas tidak menyentuh lantai"
      ]
    },
    "standard pull-ups": {
      "desc": "Pull-up bersih sebagai fondasi tinggi tarikan untuk muscle-up.",
      "cues": [
        "Rep bersih > volume longgar",
        "Hollow body membantu stabilitas",
        "Full hang tiap rep"
      ]
    },
    "chest-to-bar / high pull-ups": {
      "desc": "Tarik hingga dada mendekati / menyentuh bar. Melatih tinggi yang dibutuhkan untuk transisi muscle-up.",
      "cues": [
        "Tarik eksplosif ke atas",
        "Dada ke bar, bukan hanya dagu",
        "Turun terkontrol"
      ]
    },
    "high / chest-to-bar pull-ups": {
      "desc": "Variasi high pull untuk menghubungkan power pull dengan zona transisi.",
      "cues": [
        "Momentum tetap ke atas, bukan ke belakang",
        "Wajah menghadap depan",
        "Kaki rapat, hindari kick berlebih"
      ]
    },
    "high pull-ups": {
      "desc": "Pull eksplosif setinggi mungkin di atas garis dada untuk membuka ruang flip.",
      "cues": [
        "Power di awal tarikan",
        "Bar dekat ke tubuh",
        "Latihan juga dengan jumping pull-up jika perlu"
      ]
    },
    "explosive pull-ups (high)": {
      "desc": "Pull-up eksplosif dengan target tinggi maksimal sebelum mencoba muscle-up penuh.",
      "cues": [
        "Dead hang → tarik cepat",
        "Usahakan sternum ke bar",
        "Kualitas tiap rep"
      ]
    },
    "band-assisted dips": {
      "desc": "Dip di bar/parallel dengan bantuan band untuk membangun kekuatan dorong di atas bar.",
      "cues": [
        "Lutut tetap extended pada band",
        "Turun hingga bahu ~ setinggi siku",
        "Jangan shrug berlebih"
      ]
    },
    "negative dips": {
      "desc": "Fase turun dip secara lambat untuk kekuatan di posisi bawah (titik kritis muscle-up).",
      "cues": [
        "Turun 3-5+ detik",
        "Usahakan lebih dalam dari parallel",
        "Naik boleh dibantu"
      ]
    },
    "straight bar dips": {
      "desc": "Dip di satu bar lurus; tubuh bergeser dari condong ke tegak. Spesifik untuk finish muscle-up.",
      "cues": [
        "Mulai dari support di atas bar",
        "Turun dalam, press ke atas tall",
        "Bar dekat ke tubuh"
      ]
    },
    "straight bar dips (deep)": {
      "desc": "Straight bar dip dengan penekanan kedalaman bahu mendekati bar.",
      "cues": [
        "Bahu mendekati bar di bawah",
        "Press full lockout",
        "Kontrol, bukan bounce"
      ]
    },
    "bar lean-overs": {
      "desc": "Drill transisi: condongkan dada melewati bar dan latih 'flip' pergelangan / posisi siku di atas bar.",
      "cues": [
        "Mulai dari negative lean jika perlu",
        "Dada ke depan atas bar",
        "Hindari chicken-wing satu sisi"
      ]
    },
    "bar lean-overs / assisted muscle-up": {
      "desc": "Gabungan drill lean-over dan muscle-up dibantu (band/lompat) untuk menyambung pull-flip-press.",
      "cues": [
        "Tinggi pull dulu, baru flip",
        "Tekan ke bawah pada bar",
        "Satu rangkaian mulus"
      ]
    },
    "jumping / band-assisted muscle-ups": {
      "desc": "Muscle-up dengan lompatan atau band agar pola gerak penuh terlatih sebelum kekuatan murni cukup.",
      "cues": [
        "Swing/hollow → pull → flip → press",
        "Bantuan seminimal mungkin",
        "Full stretch di bawah untuk power"
      ]
    },
    "hollow body hold": {
      "desc": "Tahan posisi hollow (punggung bawah ke lantai, kaki & bahu sedikit angkat) untuk core muscle-up.",
      "cues": [
        "Lower back menempel lantai",
        "Tulang rusuk turun",
        "Napas tetap mengalir"
      ]
    },
    "hanging leg raise": {
      "desc": "Angkat kaki dari hang untuk core kompresi dan kontrol tubuh di bar.",
      "cues": [
        "Minimal swing",
        "Progress: tuck → straight",
        "Scapula stabil saat angkat"
      ]
    },
    "hollow + hanging leg raise": {
      "desc": "Finisher core: hollow hold dilanjut hanging leg raise.",
