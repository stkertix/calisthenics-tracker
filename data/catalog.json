        "Hollow berkualitas dulu",
        "HLR tanpa mengayun liar",
        "Istirahat setelah keduanya"
      ]
    },
    "core finisher (hollow / hlr)": {
      "desc": "Penutup sesi: hollow hold dan/atau hanging leg raise untuk stamina core.",
      "cues": [
        "Form > jumlah",
        "Jaga hang aktif",
        "Akhiri sebelum form rusak"
      ]
    },
    "muscle-up attempts (quality)": {
      "desc": "Attempt muscle-up penuh dengan fokus kualitas: swing/hollow → pull keras → lean/flip → press tall.",
